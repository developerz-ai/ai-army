{
  "name": "ai-army",
  "version": "0.1.0",
  "description": "A framework for building multi-bot AI systems",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "ai-army": "./bin/cli.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --experimental-test-module-mocks --test 'test/unit/**/*.test.js' 'test/helpers/**/*.test.js' 'src/**/*.test.js'",
    "test:integration": "npm run test:integration:db && npm run test:integration:docker",
    "test:integration:db": "node --experimental-test-module-mocks --test 'test/integration/database/**/*.test.js' 'test/integration/adapters/**/*.test.js' 'test/integration/core/**/*.test.js' 'test/integration/agent/**/*.test.js' 'test/integration/cli/**/*.test.js'",
    "test:integration:docker": "node --test 'test/integration/execution/**/*.test.js' 'test/integration/tools/**/*.test.js'",
    "test:watch": "node --test --watch 'src/**/*.test.js' 'test/**/*.test.js'",
    "lint": "eslint src/ bin/ test/",
    "lint:fix": "eslint src/ bin/ test/ --fix",
    "validate": "node bin/cli.js validate",
    "migrate": "node bin/cli.js migrate"
  },
  "keywords": [
    "ai",
    "agents",
    "chatbots",
    "multi-bot",
    "orchestration",
    "slack",
    "discord",
    "framework"
  ],
  "author": "Developerz AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerz-ai/ai-army.git"
  },
  "bugs": {
    "url": "https://github.com/developerz-ai/ai-army/issues"
  },
  "homepage": "https://github.com/developerz-ai/ai-army#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.37",
    "@ai-sdk/openai": "^3.0.25",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@slack/bolt": "^3.22.0",
    "ai": "^4.0.0",
    "chokidar": "^3.5.3",
    "commander": "^14.0.3",
    "deepmerge": "^4.3.1",
    "discord.js": "^14.16.3",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.7",
    "dotenv-expand": "^12.0.1",
    "pg": "^8.13.1",
    "ssh2": "^1.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2"
  }
}
