{
  "name": "ai-army",
  "version": "0.2.0",
  "description": "Open-source framework for orchestrating AI workers across distributed servers",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "ai-army": "./bin/cli.js"
  },
  "files": [
    "bin/cli.js",
    "src/",
    "migrations/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "node --experimental-test-module-mocks --test 'test/unit/**/*.test.js' 'test/helpers/**/*.test.js' 'src/**/*.test.js' 'bin/**/*.test.js'",
    "test:integration": "node --experimental-test-module-mocks --test --test-force-exit --test-timeout=300000 'test/integration/**/*.test.js'",
    "test:e2e": "node --experimental-test-module-mocks --test --test-force-exit --test-timeout=300000 'test/e2e/**/*.test.js'",
    "test:watch": "node --experimental-test-module-mocks --test --watch 'src/**/*.test.js' 'test/**/*.test.js'",
    "lint": "eslint src/ bin/ test/ scripts/",
    "lint:fix": "eslint src/ bin/ test/ scripts/ --fix",
    "check:links": "node scripts/check-links.js",
    "validate": "node bin/cli.js validate",
    "migrate": "node bin/cli.js migrate"
  },
  "keywords": [
    "ai",
    "agents",
    "chatbots",
    "multi-bot",
    "orchestration",
    "worker",
    "distributed",
    "ssh",
    "slack",
    "discord",
    "framework"
  ],
  "author": "Developerz AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerz-ai/ai-army.git"
  },
  "bugs": {
    "url": "https://github.com/developerz-ai/ai-army/issues"
  },
  "homepage": "https://github.com/developerz-ai/ai-army#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.91",
    "@ai-sdk/openai": "^4.0.104",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@slack/bolt": "^3.22.0",
    "ai": "^7.0.156",
    "chokidar": "^6.0.0",
    "commander": "^15.0.0",
    "deepmerge": "^4.3.1",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7",
    "dotenv-expand": "^12.0.1",
    "js-yaml": "^4.1.1",
    "pg": "^8.23.1",
    "ssh2": "^1.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10"
  }
}
