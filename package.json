{
  "name": "ai-army",
  "version": "0.1.0",
  "description": "A framework for building multi-bot AI systems",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "ai-army": "./bin/cli.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test src/**/*.test.js",
    "test:watch": "node --test --watch src/**/*.test.js",
    "lint": "eslint src/ bin/",
    "lint:fix": "eslint src/ bin/ --fix",
    "validate": "node bin/cli.js validate",
    "migrate": "node bin/cli.js migrate"
  },
  "keywords": [
    "ai",
    "agents",
    "chatbots",
    "multi-bot",
    "orchestration",
    "slack",
    "discord",
    "framework"
  ],
  "author": "Developerz AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerz-ai/ai-army.git"
  },
  "bugs": {
    "url": "https://github.com/developerz-ai/ai-army/issues"
  },
  "homepage": "https://github.com/developerz-ai/ai-army#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "ai": "^4.0.0",
    "dockerode": "^4.0.2",
    "pg": "^8.13.1",
    "@slack/bolt": "^3.22.0",
    "discord.js": "^14.16.3",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "ssh2": "^1.16.0",
    "chokidar": "^3.5.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2"
  }
}
