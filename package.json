{
  "name": "ai-army-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "Monorepo root — the AI Army app lives in apps/ai-army",
  "workspaces": [
    "apps/ai-army"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "npm run start --workspace apps/ai-army",
    "dev": "npm run dev --workspace apps/ai-army",
    "test": "npm run test --workspace apps/ai-army",
    "test:unit": "npm run test:unit --workspace apps/ai-army",
    "test:integration": "npm run test:integration --workspace apps/ai-army",
    "test:e2e": "npm run test:e2e --workspace apps/ai-army",
    "test:watch": "npm run test:watch --workspace apps/ai-army",
    "lint": "npm run lint --workspace apps/ai-army",
    "lint:fix": "npm run lint:fix --workspace apps/ai-army",
    "validate": "npm run validate --workspace apps/ai-army",
    "migrate": "npm run migrate --workspace apps/ai-army"
  }
}
