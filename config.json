{
  "defaults": {
    "model": {
      "provider": "openrouter",
      "model": "openrouter/aurora-alpha"
    },
    "sandbox": {
      "type": "incus"
    }
  },
  "providers": {
    "openrouter": {
      "type": "openrouter",
      "apiKey": "${OPENROUTER_API_KEY}"
    }
  },
  "database": {
    "url": "${DATABASE_URL}"
  },
  "api": {
    "enabled": true,
    "port": 3000,
    "host": "0.0.0.0",
    "auth": {
      "tokens": [
        {
          "token": "${ADMIN_API_KEY}",
          "role": "admin",
          "name": "admin",
          "bots": null
        },
        {
          "token": "${DANIEL_API_KEY}",
          "role": "operator",
          "name": "daniel-francoeur",
          "bots": ["daniel-francoeur-assistant"]
        },
        {
          "token": "${SEBASTIAN_API_KEY}",
          "role": "operator",
          "name": "sebastian-buza",
          "bots": ["sebastian-buza-assistant"]
        }
      ]
    }
  },
  "channels": {},
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
      "env": {}
    }
  }
}
