# AI Army Demo - Environment Variables
# Copy this file to .env and fill in your values
# Or run: ./scripts/setup.sh (copies automatically)

# === AI Provider API Keys ===
# Required for the demo bots
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# === Database ===
# PostgreSQL connection string (matches demo Docker container)
DATABASE_URL=postgresql://demo:demo@localhost:5432/ai_army_demo
