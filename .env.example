# AI Army - Environment Variables
# Copy this file to .env and fill in your values

# === AI Provider API Keys ===
# At least one provider is required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# === Database ===
DATABASE_URL=postgresql://localhost:5432/ai_army

# === Slack (optional) ===
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# === Discord (optional) ===
DISCORD_BOT_TOKEN=

# === MCP Servers (optional) ===
GITHUB_TOKEN=
