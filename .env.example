# AI Army - Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit the .env file to version control
#
# This file documents all supported environment variables for the AI Army system.
# Variables are organized by feature/service with clear indicators of:
# - REQUIRED: Must be set for the system to function
# - OPTIONAL: Nice to have, system has sensible defaults
# - Production values are documented where relevant

# ============================================================================
# === DATABASE CONFIGURATION ===
# ============================================================================
# PostgreSQL database credentials and connection string.
# Used for storing bot state, sessions, audit logs, and other persistent data.

# REQUIRED: PostgreSQL database password
# Used to connect to the database in both docker-compose and the app
# WARNING: If you change this, update DATABASE_URL password to match!
# Production: Use a strong, randomly generated password (min 32 chars, mixed case, symbols)
# Example: AI_a$7mK@pQ9#xL2nR5vW8y1bC3dE4fG6hJ
DB_PASSWORD=ai_army_dev

# REQUIRED: Full PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# - For docker-compose: use "postgres" as host (service name in docker network)
# - For local development: use "localhost"
# - For remote database: use the actual hostname/IP
# Production: Use a secure, remotely-hosted database with strong credentials
# Production example: postgresql://ai_army_prod:${DB_PASSWORD}@prod-db.internal:5432/ai_army_prod
# Note: password must match DB_PASSWORD above
DATABASE_URL=postgresql://ai_army:ai_army_dev@postgres:5432/ai_army

# ============================================================================
# === NODE.JS RUNTIME ENVIRONMENT ===
# ============================================================================
# Controls application behavior, logging verbosity, and optimizations.

# REQUIRED: Node.js environment mode
# Options: "development" | "production" | "test" | "staging"
# - development: Verbose logging, debug endpoints enabled, no performance optimizations
# - production: Minimal logging, optimized performance, strict error handling (RECOMMENDED)
# - staging: Production-like with verbose logging for pre-release testing
# - test: Optimized for test execution
# Production: NODE_ENV=production (must be set for production deployments)
NODE_ENV=development

# ============================================================================
# === API SERVER CONFIGURATION ===
# ============================================================================
# REST API server settings for monitoring, admin operations, and bot management.
# These variables control the HTTP API server that runs alongside bots.

# OPTIONAL: API server port
# Port number for the REST API server (0-65535)
# Default: 3000 (if not specified)
# Docker: This port is exposed in docker-compose.yml as ${PORT:-3000}:3000
# Production: Use port 3000 and configure a reverse proxy (nginx/haproxy) in front
# Common choices:
#   - 3000: Default, suitable for reverse proxy setups
#   - 8080: Alternative if port 3000 conflicts
# Example: PORT=3000
PORT=3000

# OPTIONAL: API authentication token(s)
# Bearer token for authenticating requests to the REST API
# Token is passed in Authorization header: Authorization: Bearer ${API_TOKEN}
# Used for:
# - Admin operations (list/start/stop bots, manage sessions)
# - Health check access
# - Audit log queries
# - Webhook management
#
# Format: Any string (recommend 32+ chars, alphanumeric + symbols)
# Multiple tokens: Can be configured in config.json under api.auth.tokens array
# Production: Use strong, randomly generated tokens
# Production example: API_TOKEN=sk-prod-7a3F$9bK!2mL@4nP#6qR%8sT^0uV&2wX
# If not set: API server authentication is disabled (development mode)
# Example: API_TOKEN=your-secret-api-token-here
API_TOKEN=

# ============================================================================
# === AI PROVIDER API KEYS ===
# ============================================================================
# API keys for external AI model providers.
# The system supports multiple providers for model inference and embeddings.
# At least ONE provider is required to use the bot system.

# OPTIONAL: Anthropic Claude API key
# Required to use Claude models (claude-3-opus, claude-sonnet, etc.)
# Get key from: https://console.anthropic.com/
# Format: sk-ant-... (typically starts with sk-ant-)
# Production: Store in secure secrets manager, never hardcode
# Used in: Bot model configuration (provider: "anthropic")
# Example: ANTHROPIC_API_KEY=sk-ant-abc123def456...
ANTHROPIC_API_KEY=

# OPTIONAL: OpenAI API key
# Required to use OpenAI models (gpt-4, gpt-3.5-turbo, etc.)
# Get key from: https://platform.openai.com/api-keys
# Format: sk-proj-... (starts with sk-proj-)
# Production: Store in secure secrets manager, never hardcode
# Used in: Bot model configuration (provider: "openai")
# Note: OpenAI charges per API call; monitor usage to avoid unexpected bills
# Example: OPENAI_API_KEY=sk-proj-xyz789uvw012...
OPENAI_API_KEY=

# ============================================================================
# === COMMUNICATION CHANNELS (OPTIONAL) ===
# ============================================================================
# Integration with external messaging platforms.
# Only configure channels you intend to use.

# OPTIONAL: Slack bot integration
# Enables bots to send/receive messages via Slack
# Create bot at: https://api.slack.com/apps
# Get tokens from Bot Token Scopes page
# Format: xoxb-... (bot token)
# Production: Use workspace-scoped tokens, configure with minimal required scopes
# Scopes needed: chat:write, reactions:read, app_mentions:read
# Example: SLACK_BOT_TOKEN=xoxb-123456789012-1234567890123-abcdefghijklmnop
SLACK_BOT_TOKEN=

# OPTIONAL: Slack app-level token (for socket mode)
# Used if bots connect via Slack Socket Mode (recommended for private deployments)
# Format: xapp-... (app token)
# Get from: https://api.slack.com/apps -> Socket Mode
# Example: SLACK_APP_TOKEN=xapp-1-XXXXXXXXXXXX-1234567890012-abcdef
SLACK_APP_TOKEN=

# OPTIONAL: Discord bot token
# Enables bots to send/receive messages via Discord
# Create bot at: https://discord.com/developers/applications
# Get token from: Bot > TOKEN (show and copy)
# Format: ODE... (typically 70+ character alphanumeric string)
# Production: Use a dedicated bot account with minimal required permissions (Send Messages, Read Messages/History)
# Permissions needed for 0x2400 (8192 + 2048): read messages, send messages
# Example: DISCORD_BOT_TOKEN=ODE4NTE1MzU5NjI3MTk5NDg4.GXxPzQ.abcdefghijklmnopqrstuvwxyz
DISCORD_BOT_TOKEN=

# ============================================================================
# === VERSION CONTROL & MCP SERVERS (OPTIONAL) ===
# ============================================================================
# Integration with external services for tools and data sources.

# OPTIONAL: GitHub personal access token
# Used for GitHub-related tools (repository access, pull requests, etc.)
# Create token at: https://github.com/settings/tokens
# Scopes needed depend on intended operations:
# - repo: Full repository access (for private repos)
# - read:user: Read user profile (for public operations)
# - gist: Gist access (if using GitHub Gists)
# Format: ghp_... (personal access token) or github_pat_... (fine-grained)
# Production: Use fine-grained personal access tokens with minimal required scopes
# Expiration: Set token expiration date (recommend 90 days) and rotate regularly
# Example: GITHUB_TOKEN=ghp_1234567890abcdefghijklmnopqrstuv
GITHUB_TOKEN=

# ============================================================================
# === DOCKER COMPOSE PORT MAPPINGS ===
# ============================================================================
# Host ports exposed for containerized deployments.
# Only needed when using docker-compose.

# OPTIONAL: PostgreSQL port mapping
# Maps container port 5432 to host port
# Default: 5432
# Change if port 5432 is already in use on your system
# Only used in docker-compose; not needed for cloud-hosted databases
# Example: PG_PORT=5433
# PG_PORT=5432

# Note: API server port is controlled by PORT variable above
# Default exposed as ${PORT:-3000}:3000 in docker-compose.yml

# ============================================================================
# === PRODUCTION DEPLOYMENT CHECKLIST ===
# ============================================================================
# Before deploying to production:
#
# Database:
#   [ ] Generate strong DB_PASSWORD (32+ chars, mixed case, symbols, numbers)
#   [ ] Update DATABASE_URL with production database credentials
#   [ ] Ensure database has SSL enabled
#   [ ] Set up automated backups (at least daily)
#   [ ] Test backup restore procedure
#
# API Security:
#   [ ] Set NODE_ENV=production
#   [ ] Generate strong API_TOKEN (32+ chars) for API authentication
#   [ ] Configure reverse proxy (nginx/haproxy) in front of API
#   [ ] Enable HTTPS/TLS on reverse proxy
#   [ ] Restrict API access by IP if possible
#
# AI Provider Keys:
#   [ ] Use secrets manager (AWS Secrets Manager, Vault, etc.)
#   [ ] Never commit credentials to version control
#   [ ] Rotate API keys quarterly
#   [ ] Monitor API usage for unexpected spikes
#
# Communication Channels:
#   [ ] If using Slack: Create bot with minimal required scopes
#   [ ] If using Discord: Use dedicated bot account, limit permissions
#   [ ] If using GitHub: Use fine-grained PAT with expiration date
#
# Monitoring & Logging:
#   [ ] Set up centralized logging (CloudWatch, DataDog, Splunk, etc.)
#   [ ] Configure health check monitoring on API endpoints
#   [ ] Set up alerts for errors, failed bot executions, API latency
#   [ ] Monitor database performance and connection pool usage
#   [ ] Enable audit logging to track all admin operations
#
# Docker Deployment:
#   [ ] Build Docker image with specific version tags (not latest)
#   [ ] Use read-only filesystem where possible
#   [ ] Set resource limits (memory, CPU) in docker-compose
#   [ ] Run containers with non-root user
#   [ ] Enable restart policies (unless-stopped)
#
# ============================================================================
