# AI Assistants Army - Environment Variables

# Database
DATABASE_URL=postgresql://ai_army:password@localhost:5432/ai_army

# AI Providers
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# Discord
DISCORD_BOT_TOKEN=your-discord-bot-token

# Secrets Management (Optional)
BW_SERVER=https://vault.bitwarden.com
BW_CLIENT_ID=your-bitwarden-client-id
BW_CLIENT_SECRET=your-bitwarden-client-secret

# MCP Servers
GITHUB_TOKEN=your-github-token
NOTION_TOKEN=your-notion-token

# Worker Configuration (Optional)
WORKER_SSH_KEY_PATH=/path/to/ssh/key
