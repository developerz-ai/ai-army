{
  "defaults": {
    "model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-5",
      "temperature": 0.7,
      "maxTokens": 4096
    },
    "sandbox": {
      "type": "docker",
      "image": "node:22-slim",
      "memory": "512m",
      "cpus": 1,
      "network": "bridge"
    },
    "tools": ["bash", "readFile", "writeFile"],
    "maxSteps": 30,
    "compaction": {
      "enabled": true,
      "threshold": 50000,
      "flushBeforeCompact": true
    }
  },

  "providers": {
    "anthropic": {
      "type": "anthropic",
      "apiKey": "${ANTHROPIC_API_KEY}"
    }
  },

  "channels": {},

  "mcpServers": {},

  "secrets": {
    "provider": "env"
  }
}
