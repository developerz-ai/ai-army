# AI Assistants Army - Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit the .env file to version control

# === Database ===
# Password for the PostgreSQL database (used by docker-compose)
DB_PASSWORD=ai_army_dev
# Full connection string (used by the application)
DATABASE_URL=postgresql://ai_army:ai_army_dev@localhost:5432/ai_army

# === AI Provider API Keys ===
# At least one provider is required
ANTHROPIC_API_KEY=

# === Node Environment ===
# Set to "production" for production deployments
NODE_ENV=development

# === Channels (optional) ===
# Slack - Socket Mode requires both tokens
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=

# Discord
# DISCORD_BOT_TOKEN=

# === MCP Servers (optional) ===
# GITHUB_TOKEN=

# === REST API (optional) ===
# PORT=3000
