# AI Army Project — Environment Variables
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# === LLM Provider ===
# Set the API key for your chosen LLM provider (see ai-army.yml)
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# === Servers ===
# IP addresses or hostnames for your remote servers (see servers.yml)
VPS_1_HOST=
# VPS_2_HOST=

# === Optional ===
# AI_ARMY_API_KEY=
# GITHUB_TOKEN=
