#!/usr/bin/env bash
# one-command setup — established by dz-runner setup mode. One command; adjust as the repo grows.
set -euo pipefail
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
  mise install || echo "warning: mise install failed — continuing with the system node" >&2
fi

npm ci

# .env holds the local secrets and is gitignored. Create it from the tracked
# template on a fresh checkout; never overwrite an existing one.
if [ -f .env ]; then
  env_state="kept (already present — not overwritten)"
else
  cp .env.example .env
  env_state="created from .env.example"
fi

# PostgreSQL 18 keeps its data under /var/lib/postgresql/<major>/ and refuses
# to start while anything is mounted at the legacy /var/lib/postgresql/data
# path. docker-compose.yml mounts pgdata where the image expects it, so no
# override file is needed here.
docker compose -f docker-compose.yml up -d --wait postgres

# The test suite runs against ai_army_test — create it once, idempotently.
if docker exec ai-army-postgres psql -U ai_army -d postgres -tc \
  "SELECT 1 FROM pg_database WHERE datname='ai_army_test'" | grep -q 1; then
  test_db_state="ai_army_test (already present)"
else
  docker exec ai-army-postgres psql -U ai_army -d postgres -c \
    "CREATE DATABASE ai_army_test OWNER ai_army;"
  test_db_state="ai_army_test (created)"
fi

cat <<EOF
Setup complete.
  dependencies   npm ci done
  .env           $env_state
  postgres       ai-army-postgres running (localhost:${PG_PORT:-5432})
  test database  $test_db_state

Next: ./bin/dev runs the app, ./bin/check lints and tests.
Replace the placeholder keys in .env before using a real provider.
EOF
