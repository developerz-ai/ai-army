# Dependencies (will be installed fresh via npm ci)
node_modules/

# Environment files (secrets — pass via env vars at runtime)
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*

# Data directories (mounted at runtime)
data/

# Testing
coverage/
.nyc_output/
test/

# Build outputs
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Task master (orchestrator state)
.claude-task-master/

# Secrets
*.key
*.pem

# Git
.git/
.gitignore

# Docker files (avoid recursive builds)
Dockerfile
docker-compose.yml

# Documentation (not needed at runtime)
docs/
demo/
AGENT.md
CHANGELOG.md
CLAUDE.md
CONTRIBUTING.md
README.md
LICENSE

# Dev tooling configs
eslint.config.js
