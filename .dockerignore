# Context-root ignore for docker builds of apps/ai-army/Dockerfile.
# Both compose files use the repo root as build context, so every pattern here
# is a bare name that matches at any depth. .env.example stays includable.

# Git & CI
.git/
.github/

# Dependencies (installed fresh in the image)
node_modules/

# Data directories (mounted at runtime)
data/

# Logs
logs/
*.log

# Testing
coverage/

# Build outputs
dist/
build/

# Temporary files
tmp/
temp/

# Local team setups
team-setups/

# Environment files (secrets — pass via env vars at runtime)
.env
.env.local
.env.*.local
