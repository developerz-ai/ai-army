#!/usr/bin/env bash
# pre-commit gate — established by dz-runner setup mode. Runs the local
# `bin/check` gate (lint + test suite). CI does not run bin/check: it runs its
# own jobs (lint, unit-tests, integration-tests, e2e-tests, validate-demo).
# ACTIVATE IT (once, per clone): git config core.hooksPath .githooks
set -euo pipefail
cd "$(dirname "$0")/.."
exec bin/check
